# Service config storage (where this app stores its own settings/jobs/users)
MONGODB_URI=mongodb://localhost:27017/mongo-backup

# Auth — JWT signing + first admin seeded on boot
JWT_SECRET=replace_with_random_32_plus_chars_secret_here
JWT_EXPIRE=30d
ENCRYPTION_KEY=replace_with_32_byte_hex_for_aes_gcm_xxxxxxxxxxxx

ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=ChangeMe!Strong123
ADMIN_NAME=Admin

# Public app URL — must match Google OAuth redirect
APP_URL=http://localhost:13280

# Google OAuth (Drive API)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: $APP_URL/api/gdrive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:13280/api/gdrive/callback

# Backup runtime
BACKUP_TMP_DIR=/tmp/mongo-backup
MONGODUMP_BIN=mongodump
PGDUMP_BIN=pg_dump
# false disables every backup cron on this instance (manual and API triggers still work).
SCHEDULER_ENABLED=true

# MCP endpoint (POST /mcp) for Claude Code and other MCP clients.
# Set to false to remove the endpoint entirely; it answers 404 then.
# Callers authenticate with the same dashboard JWT the API already uses.
MCP_ENABLED=true

# Override machine identity. If set, targets pinned to a local Mongo URI use this
# value instead of /etc/machine-id (or hostname hash fallback). Useful in Docker
# or when you want the same identity across containers/hosts.
MACHINE_ID=
